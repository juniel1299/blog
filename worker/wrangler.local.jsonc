{
  // Local-only config without AI/Vectorize (those need a Cloudflare login). Used by `npm run dev:local`
  // to try /health and /admin/preview against the real blog. Indexing itself needs `npm run dev` or a deploy.
  "name": "tistory-ai-assistant-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5173", "BLOG_ORIGIN": "https://problem-child.tistory.com" },
  "d1_databases": [{ "binding": "DB", "database_name": "tistory-ai-assistant", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }]
}
