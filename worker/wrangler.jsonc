{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tistory-ai-assistant-api",
  "main": "src/index.js",
  // Insight dashboard page (public/dashboard/); its data comes from /admin/insights with ADMIN_TOKEN.
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated browser origins allowed to call the API.
    "ALLOWED_ORIGINS": "https://problem-child.tistory.com,http://localhost:5173",
    "BLOG_ORIGIN": "https://problem-child.tistory.com"
    // ADMIN_TOKEN is a secret: `npx wrangler secret put ADMIN_TOKEN` (local: worker/.dev.vars).
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tistory-ai-assistant",
      "database_id": "0c238f1e-f28a-41a3-9a7c-f5d1372fd2ad",
      "migrations_dir": "migrations"
    }
  ],
  // Create once: npx wrangler vectorize create tistory-posts --dimensions=1024 --metric=cosine
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "tistory-posts" }],
  "ai": { "binding": "AI" },
  // Per-IP limit on the public search API (namespace_id is any account-unique integer string).
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Analytics beacons (page views, card clicks): separate so reading pages never uses the search budget.
    { "name": "EVENTS_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Incremental sync: each run re-indexes at most 3 changed posts (free-plan CPU/subrequest limits).
  "triggers": { "crons": ["*/10 * * * *"] }
}
